-- ===== SISTEMA DE BACKUP E RESET =====
local ShaderBackup = {
    originalLighting = {},
    originalMaterials = {},
    createdInstances = {},
    connections = {},
    renderStepped = nil
}

local function backupLighting()
    local properties = {
        "Ambient", "Brightness", "ColorShift_Bottom", "ColorShift_Top",
        "EnvironmentDiffuseScale", "EnvironmentSpecularScale", "GlobalShadows",
        "OutdoorAmbient", "ShadowSoftness", "Technology", "ClockTime", "GeographicLatitude",
        "ExposureCompensation", "FogColor", "FogEnd", "FogStart"
    }
    for _, prop in ipairs(properties) do
        local success, value = pcall(function()
            return Lighting[prop]
        end)
        if success then
            ShaderBackup.originalLighting[prop] = value
        end
    end
    for _, child in ipairs(Lighting:GetChildren()) do
        ShaderBackup.originalLighting[child.Name] = true
    end
end

local function restoreOriginalState()
    -- Desconecta todas as conexões
    for _, conn in ipairs(ShaderBackup.connections) do
        if conn then
            pcall(function() conn:Disconnect() end)
        end
    end
    ShaderBackup.connections = {}
    if ShaderBackup.renderStepped then
        pcall(function() ShaderBackup.renderStepped:Disconnect() end)
        ShaderBackup.renderStepped = nil
    end

    -- Destrói instâncias criadas pelo shader
    for _, instance in ipairs(ShaderBackup.createdInstances) do
        if instance and instance.Parent then
            pcall(function() instance:Destroy() end)
        end
    end
    ShaderBackup.createdInstances = {}

    -- ============================================
    -- RESTAURAÇÃO COMPLETA DO CÉU E ILUMINAÇÃO
    -- ============================================

    -- Remove TODOS os efeitos de pós-processamento
    local postEffectTypes = {
        "BlurEffect", "ColorCorrectionEffect", "DepthOfFieldEffect",
        "SunRaysEffect", "BloomEffect", "Atmosphere", "Clouds", "Sky"
    }

    for _, effectType in ipairs(postEffectTypes) do
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA(effectType) then
                if not ShaderBackup.originalLighting[child.Name] then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end

    -- Remove QUALQUER PostEffect residual (genérico)
    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("PostEffect") then
            pcall(function() child:Destroy() end)
        end
    end

    -- Remove Atmosphere e Clouds se existirem
    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("Atmosphere") or child:IsA("Clouds") then
            pcall(function() child:Destroy() end)
        end
    end

    -- Cria um Sky padrão do Roblox (céu normal)
    local existingSky = Lighting:FindFirstChildOfClass("Sky")
    if existingSky then
        pcall(function() existingSky:Destroy() end)
    end

    local defaultSky = Instance.new("Sky")
    defaultSky.Name = "DefaultSky"
    defaultSky.SkyboxBk = "rbxassetid://6412503613"
    defaultSky.SkyboxDn = "rbxassetid://6412504679"
    defaultSky.SkyboxFt = "rbxassetid://6412504335"
    defaultSky.SkyboxLf = "rbxassetid://6412503990"
    defaultSky.SkyboxRt = "rbxassetid://6412503832"
    defaultSky.SkyboxUp = "rbxassetid://6412504253"
    defaultSky.SunTextureId = "rbxassetid://6196665106"
    defaultSky.MoonTextureId = "rbxassetid://6196668029"
    defaultSky.SunAngularSize = 11
    defaultSky.MoonAngularSize = 11
    defaultSky.StarCount = 3000
    defaultSky.Parent = Lighting

    -- ============================================
    -- RESET COMPLETO DA CÂMERA (ANTI-EMBAÇAMENTO)
    -- ============================================

    -- Remove TODOS os efeitos na câmera
    for _, child in ipairs(Camera:GetChildren()) do
        pcall(function() child:Destroy() end)
    end

    -- Reset forçado de propriedades da câmera
    pcall(function()
        Camera.FieldOfView = 70
        Camera.CameraType = Enum.CameraType.Custom
    end)

    -- ============================================
    -- RESET DAS PROPRIEDADES DE ILUMINAÇÃO
    -- ============================================

    -- Restaura propriedades do backup se existirem, senão usa padrão Roblox
    local function restoreOrDefault(prop, defaultValue)
        pcall(function()
            if ShaderBackup.originalLighting[prop] ~= nil then
                Lighting[prop] = ShaderBackup.originalLighting[prop]
            else
                Lighting[prop] = defaultValue
            end
        end)
    end

    restoreOrDefault("Ambient", Color3.fromRGB(127, 127, 127))
    restoreOrDefault("Brightness", 2)
    restoreOrDefault("ColorShift_Bottom", Color3.fromRGB(0, 0, 0))
    restoreOrDefault("ColorShift_Top", Color3.fromRGB(0, 0, 0))
    restoreOrDefault("EnvironmentDiffuseScale", 1)
    restoreOrDefault("EnvironmentSpecularScale", 1)
    restoreOrDefault("GlobalShadows", true)
    restoreOrDefault("OutdoorAmbient", Color3.fromRGB(127, 127, 127))
    restoreOrDefault("ShadowSoftness", 0.2)
    restoreOrDefault("Technology", Enum.Technology.Future)
    restoreOrDefault("ClockTime", 14)
    restoreOrDefault("GeographicLatitude", 41.733)
    restoreOrDefault("ExposureCompensation", 0)
    restoreOrDefault("FogColor", Color3.fromRGB(192, 192, 192))
    restoreOrDefault("FogEnd", 100000)
    restoreOrDefault("FogStart", 0)

    -- ============================================
    -- RESTAURA MATERIAIS DAS PARTES
    -- ============================================

    for part, originalMaterial in pairs(ShaderBackup.originalMaterials) do
        if part and part.Parent then
            pcall(function()
                part.Material = originalMaterial
            end)
        end
    end
    ShaderBackup.originalMaterials = {}

    -- ============================================
    -- REMOVE GUIs DO SHADER
    -- ============================================

    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui.Name == "ShaderPeterGUI" or gui.Name == "ShaderConfirmGUI" or gui.Name:match("Shader") then
            pcall(function() gui:Destroy() end)
        end
    end

    -- ============================================
    -- LIMPEZA FINAL - GARANTIA ABSOLUTA
    -- ============================================

    -- Segunda passagem: remove QUALQUER coisa que possa causar embaçamento
    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Clouds") or child:IsA("Sky") then
            pcall(function() child:Destroy() end)
        end
    end

    -- Força atualização do céu
    pcall(function()
        Lighting.OutdoorAmbient = Color3.fromRGB(127, 127, 127)
        Lighting.Ambient = Color3.fromRGB(127, 127, 127)
        Lighting.Brightness = 2
    end)

    print("✅ SHADER COMPLETAMENTE REMOVIDO - JOGO RESTAURADO AO NORMAL")
end

backupLighting()

-- ===== ANIMAÇÃO ÉPICA DE TRANSIÇÃO =====
local function playShutdownAnimation()
    local camera = Workspace.CurrentCamera
    local originalCFrame = camera.CFrame

    local effectGui = Instance.new("ScreenGui")
    effectGui.Name = "ShaderEffectGUI"
    effectGui.ResetOnSpawn = false
    effectGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    effectGui.Parent = playerGui

    local flash = Instance.new("Frame")
    flash.Name = "Flash"
    flash.Size = UDim2.new(1, 0, 1, 0)
    flash.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    flash.BackgroundTransparency = 1
    flash.BorderSizePixel = 0
    flash.ZIndex = 999
    flash.Parent = effectGui

    local particles = {}
    for i = 1, 30 do
        local particle = Instance.new("Frame")
        particle.Size = UDim2.new(0, math.random(2, 6), 0, math.random(2, 6))
        particle.Position = UDim2.new(math.random(), 0, 1, 0)
        particle.BackgroundColor3 = Color3.fromRGB(
            math.random(100, 255),
            math.random(100, 255),
            math.random(200, 255)
        )
        particle.BackgroundTransparency = 0.3
        particle.BorderSizePixel = 0
        particle.ZIndex = 998
        particle.Parent = effectGui
        local pCorner = Instance.new("UICorner")
        pCorner.CornerRadius = UDim.new(1, 0)
        pCorner.Parent = particle
        table.insert(particles, particle)
    end

    TweenService:Create(flash, TweenInfo.new(0.15), {
        BackgroundTransparency = 0
    }):Play()
    task.wait(0.15)

    for _, particle in ipairs(particles) do
        local duration = math.random(0.8, 1.5)
        local endY = math.random(-0.5, -0.2)
        TweenService:Create(particle, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(particle.Position.X.Scale, 0, endY, 0),
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 0, 0, 0)
        }):Play()
    end

    local shakeConnection
    local shakeStart = tick()
    shakeConnection = RunService.RenderStepped:Connect(function()
        local elapsed = tick() - shakeStart
        if elapsed > 1.2 then
            shakeConnection:Disconnect()
            return
        end
        local intensity = (1.2 - elapsed) * 0.3
        camera.CFrame = originalCFrame * CFrame.new(
            math.random(-100, 100) / 100 * intensity,
            math.random(-100, 100) / 100 * intensity,
            math.random(-50, 50) / 100 * intensity
        )
    end)

    TweenService:Create(flash, TweenInfo.new(0.4), {
        BackgroundTransparency = 1
    }):Play()

    local darkScreen = Instance.new("Frame")
    darkScreen.Name = "DarkScreen"
    darkScreen.Size = UDim2.new(1, 0, 1, 0)
    darkScreen.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    darkScreen.BackgroundTransparency = 1
    darkScreen.BorderSizePixel = 0
    darkScreen.ZIndex = 997
    darkScreen.Parent = effectGui

    TweenService:Create(darkScreen, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        BackgroundTransparency = 0
    }):Play()

    task.wait(0.5)

    restoreOriginalState()
    camera.CFrame = originalCFrame

    local rebuildFlash = Instance.new("Frame")
    rebuildFlash.Name = "RebuildFlash"
    rebuildFlash.Size = UDim2.new(1, 0, 1, 0)
    rebuildFlash.BackgroundColor3 = Color3.fromRGB(200, 220, 255)
    rebuildFlash.BackgroundTransparency = 0
    rebuildFlash.BorderSizePixel = 0
    rebuildFlash.ZIndex = 999
    rebuildFlash.Parent = effectGui

    local rebuildParticles = {}
    for i = 1, 20 do
        local rp = Instance.new("Frame")
        rp.Size = UDim2.new(0, math.random(3, 8), 0, math.random(3, 8))
        rp.Position = UDim2.new(math.random(), 0, -0.2, 0)
        rp.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        rp.BackgroundTransparency = 0.5
        rp.BorderSizePixel = 0
        rp.ZIndex = 998
        rp.Parent = effectGui
        local rpCorner = Instance.new("UICorner")
        rpCorner.CornerRadius = UDim.new(1, 0)
        rpCorner.Parent = rp
        table.insert(rebuildParticles, rp)
    end

    for _, rp in ipairs(rebuildParticles) do
        TweenService:Create(rp, TweenInfo.new(math.random(0.5, 1.2), Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(rp.Position.X.Scale, 0, 1.2, 0),
            BackgroundTransparency = 1
        }):Play()
    end

    TweenService:Create(rebuildFlash, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 1
    }):Play()

    TweenService:Create(darkScreen, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 1
    }):Play()

    task.wait(1.5)
    effectGui:Destroy()

    local doneGui = Instance.new("ScreenGui")
    doneGui.Name = "ShaderDoneGUI"
    doneGui.ResetOnSpawn = false
    doneGui.Parent = playerGui

    local doneText = Instance.new("TextLabel")
    doneText.Size = UDim2.new(0, 300, 0, 40)
    doneText.Position = UDim2.new(0.5, -150, 0.85, 0)
    doneText.BackgroundTransparency = 1
    doneText.Text = "✓ MUNDO RESTAURADO"
    doneText.TextColor3 = Color3.fromRGB(100, 255, 150)
    doneText.TextSize = 18
    doneText.Font = Enum.Font.GothamBold
    doneText.TextTransparency = 1
    doneText.Parent = doneGui

    TweenService:Create(doneText, TweenInfo.new(0.5), {
        TextTransparency = 0
    }):Play()

    task.wait(2)
    TweenService:Create(doneText, TweenInfo.new(0.5), {
        TextTransparency = 1
    }):Play()
    task.wait(0.5)
    doneGui:Destroy()
end

