local function ativarShader()
	for _,v in pairs(Lighting:GetChildren()) do
		if v.Name == "NaturalBloom"
		or v.Name == "NaturalBlur"
		or v.Name == "NaturalDOF"
		or v.Name == "NaturalColor" then
			v:Destroy()
		end
	end

	local bloom = Instance.new("BloomEffect", Lighting)
	bloom.Name = "NaturalBloom"
	bloom.Intensity = 0.18
	bloom.Size = 22
	bloom.Threshold = 2.1

	local blur = Instance.new("BlurEffect", Lighting)
	blur.Name = "NaturalBlur"

	local color = Instance.new("ColorCorrectionEffect", Lighting)
	color.Name = "NaturalColor"
	color.Contrast = 0.05

	local dof = Instance.new("DepthOfFieldEffect", Lighting)
	dof.Name = "NaturalDOF"
	dof.FocusDistance = 38
	dof.InFocusRadius = 28

	local lastLook = camera.CFrame.LookVector
	local smooth = 0

	RunService.RenderStepped:Connect(function(dt)
		local diff = (camera.CFrame.LookVector - lastLook).Magnitude
		local speed = diff / math.max(dt,0.016)

		smooth += (speed - smooth) * 0.05

		blur.Size = math.clamp(smooth * 12,0,10)
		bloom.Intensity = math.clamp(0.18 + smooth * 0.45,0.18,0.8)
		dof.FarIntensity = math.clamp(smooth * 0.28,0,0.22)
		dof.NearIntensity = math.clamp(smooth * 0.08,0,0.05)
		dof.InFocusRadius = math.clamp(28 - smooth * 8,20,28)

		lastLook = camera.CFrame.LookVector
	end)
end

toggle.MouseButton1Click:Connect(function()
	if not enabled then return end

